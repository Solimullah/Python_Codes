{
  "$schema": "https://railway.app/railway.schema.json",
  "services": [
    {
      "name": "backend",
      "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "backend/Dockerfile"
      },
      "ports": [
        {
          "port": 8000
        }
      ]
    },
    {
      "name": "frontend",
      "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "frontend/Dockerfile"
      },
      "ports": [
        {
          "port": 5173
        }
      ]
    }
  ],
  "databases": [
    {
      "name": "postgres",
      "plugin": "postgresql"
    }
  ]
}
